{
  "manifest_version": 3,
  "name": "Scene Explainer GX",
  "version": "1.2.2",
  "description": "Instantly explains movie scenes you are watching on streaming sites using Google Gemini.",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.streamingcommunityz.photos/*", "*://*/*"],
      "exclude_matches": ["*://gemini.google.com/*"],
      "all_frames": true,
      "css": ["content.css"],
      "js": ["content.js"]
    },
    {
      "matches": ["*://gemini.google.com/*"],
      "js": ["gemini_scraper.js"]
    }
  ]
}
